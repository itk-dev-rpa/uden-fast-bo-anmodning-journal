# Local debug settings for local_debug.py.
# Copy this file to ".env" (which is gitignored) and fill in the values from
# your OpenOrchestrator TEST environment. Never commit real connection strings
# or keys.

# Human-friendly process name shown in the Orchestrator log.
OO_PROCESS_NAME=UFB Journalisering (debug)

# ODBC connection string to the OpenOrchestrator (test) database.
OO_CONNECTION_STRING=

# Secret key used to decrypt credentials/constants in the database.
OO_CRYPTO_KEY=

# Optional process arguments passed to the robot as a JSON object.
# Supported keys:
#   dry_run   (bool)  - if true, no changes are made (only read-only Nova lookups
#                       and logging of intended actions). Default false.
#   max_mails (int)   - process at most this many mails. Default: no limit.
# Example (dry-run):        {"dry_run": true}
# Example (one live mail):  {"dry_run": false, "max_mails": 1}
OO_PROCESS_ARGS={"dry_run": true}

# Trigger/job ids. Leave empty for local debugging (treated as None). If set,
# they must be valid UUID strings, as OpenOrchestrator calls UUID() on them.
OO_TRIGGER_ID=
OO_JOB_ID=
